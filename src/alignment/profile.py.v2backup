from collections import Counter

from src.lexer.lexer import lex


TRIVIA_TYPES = {"WHITESPACE", "NEWLINE", "COMMENT"}


def _source_kind(source_text: str) -> str:
    """Describe whether a tokenizer token's source span contains code or whitespace."""
    if not source_text:
        return "EMPTY"

    has_whitespace = any(char.isspace() for char in source_text)
    has_non_whitespace = any(not char.isspace() for char in source_text)

    if has_whitespace and has_non_whitespace:
        return "MIXED_WHITESPACE_AND_CODE"
    if has_whitespace:
        return "WHITESPACE_ONLY"
    return "NO_WHITESPACE"


def build_alignment_profile(source, tokenizer):
    """
    Compare tokenizer token offsets with Python lexer token boundaries.

    Trivia (whitespace, newlines, comments) is excluded when deciding
    meaningful lexical coverage, but is recorded separately.

    Categories:
      WHOLE_LEXEME: covers exactly one complete meaningful lexeme,
                    possibly with surrounding whitespace.
      SUB_LEXEME:   covers only part of one meaningful lexeme.
      BOUNDARY_STRADDLING: overlaps multiple meaningful lexemes, or
                           contains code outside the one overlapping lexeme.
      UNCLASSIFIED: contains no meaningful lexical code.
      ZERO_LENGTH:  tokenizer reports an empty source span.
    """
    all_lexer_tokens = lex(source, include_trivia=True)
    meaningful_tokens = [
        token
        for token in all_lexer_tokens
        if token.token_type not in TRIVIA_TYPES and token.end > token.start
    ]

    encoded = tokenizer(
        source,
        add_special_tokens=False,
        return_offsets_mapping=True,
    )
    token_ids = encoded["input_ids"]
    offsets = encoded["offset_mapping"]
    token_strings = tokenizer.convert_ids_to_tokens(token_ids)

    counts = Counter()
    source_kind_counts = Counter()
    details = []

    for token_id, token_string, offset in zip(token_ids, token_strings, offsets):
        start, end = offset
        source_text = source[start:end]

        if start == end:
            category = "ZERO_LENGTH"
        else:
            overlapping = [
                token for token in meaningful_tokens
                if token.start < end and start < token.end
            ]

            code_positions = [
                pos for pos in range(start, end)
                if not source[pos].isspace()
            ]

            if not overlapping or not code_positions:
                category = "UNCLASSIFIED"
            elif len(overlapping) > 1:
                category = "BOUNDARY_STRADDLING"
            else:
                lexeme = overlapping[0]

                # Every non-whitespace character in the source span must
                # belong to the same lexer lexeme.
                code_is_inside_lexeme = all(
                    lexeme.start <= pos < lexeme.end
                    for pos in code_positions
                )

                if not code_is_inside_lexeme:
                    category = "BOUNDARY_STRADDLING"
                elif (
                    start <= lexeme.start
                    and end >= lexeme.end
                    and source[lexeme.start:lexeme.end] == lexeme.value
                ):
                    category = "WHOLE_LEXEME"
                else:
                    category = "SUB_LEXEME"

        overlapping_all = [
            token for token in all_lexer_tokens
            if token.start < end and start < token.end
        ] if start != end else []

        source_kind = _source_kind(source_text)

        if any(token.token_type == "COMMENT" for token in overlapping_all):
            if source_kind == "NO_WHITESPACE":
                source_kind = "COMMENT_OR_CODE"
            elif source_kind == "MIXED_WHITESPACE_AND_CODE":
                source_kind = "MIXED_TRIVIA_AND_CODE"

        overlapping_meaningful = [
            token for token in meaningful_tokens
            if start < end and token.start < end and start < token.end
        ]

        # Exact alignment is stricter than whole-lexeme coverage:
        # the token's source span must equal one lexeme's span.
        exact_boundary_match = (
            len(overlapping_meaningful) == 1
            and start == overlapping_meaningful[0].start
            and end == overlapping_meaningful[0].end
        )

        counts[category] += 1
        source_kind_counts[source_kind] += 1

        details.append({
            "token_id": token_id,
            "token": token_string,
            "start": start,
            "end": end,
            "source_text": source_text,
            "category": category,
            "source_kind": source_kind,
            "exact_boundary_match": exact_boundary_match,
            "overlapping_lexer_types": list(
                dict.fromkeys(token.token_type for token in overlapping_all)
            ),
            "overlapping_lexemes": [
                token.value for token in overlapping_meaningful
            ],
        })

    total = len(token_ids)

    return {
        "token_count": total,
        "counts": dict(counts),
        "source_kind_counts": dict(source_kind_counts),
        "exact_boundary_match_count": sum(
            detail["exact_boundary_match"] for detail in details
        ),
        "exact_boundary_match_ratio": (
            sum(detail["exact_boundary_match"] for detail in details) / total
            if total else 0.0
        ),
        "straddling_ratio": (
            counts["BOUNDARY_STRADDLING"] / total if total else 0.0
        ),
        "tokens": details,
    }
